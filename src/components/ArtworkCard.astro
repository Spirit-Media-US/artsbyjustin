---
import { urlFor } from '../lib/sanity'

interface Props {
  title: string
  slug: string
  image: any
  medium: string
  price: number | null
  sold: boolean
}

const { title, slug, image, medium, price, sold } = Astro.props
const imageUrl = image ? urlFor(image).width(800).format('webp').url() : ''
const priceDisplay = sold ? 'Sold' : price ? `$${Number(price).toLocaleString()}` : 'Inquire'
---

<article class="group cursor-pointer">
  <a href={`/artwork/${slug}`}>
    <div class="aspect-[3/4] bg-surface-container overflow-hidden mb-6 relative">
      {imageUrl ? (
        <img
          src={imageUrl}
          alt={title}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      ) : (
        <div class="w-full h-full bg-surface-low"></div>
      )}
      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500"></div>
    </div>
    <div class="flex justify-between items-start">
      <div>
        <h3 class="font-display text-xl lg:text-2xl mb-1 text-ink">{title}</h3>
        <p class="text-xs uppercase tracking-widest text-ink-muted">{medium}</p>
      </div>
      <div class:list={['font-display text-lg', sold ? 'text-outline' : 'text-gold-bright']}>
        {priceDisplay}
      </div>
    </div>
  </a>
</article>
