---
import Layout from '../layouts/Layout.astro';
import { getShopItems, getSiteSettings, urlFor } from '../lib/sanity';

const siteSettings = await getSiteSettings();
const galleryImages = siteSettings?.galleryImages || [];
const etsyShopUrl = siteSettings?.etsyShopUrl || '';

// Generate URLs for gallery images
const galleryImageUrls = galleryImages.map((img: any) => urlFor(img).width(800).url()).slice(0, 2);
const printImage1 =
	galleryImageUrls[0] ||
	'https://res.cloudinary.com/dztkjeayt/image/upload/v1772764073/7F349BFB-3ACD-47D6-9AC5-56FFEB7345B9_jlvpk9.jpg';
const printImage2 =
	galleryImageUrls[1] ||
	'https://res.cloudinary.com/dztkjeayt/image/upload/v1772764073/A34786D0-51D9-4524-B2A2-C2723CECE012_ugjrze.jpg';

// Fetch shop items from Sanity
const rawShopItems = await getShopItems();

// Normalize to the shape the JS client code expects
const shopItemsData = rawShopItems.map((item: any, i: number) => {
	const img = item.externalImageUrl || (item.image ? urlFor(item.image).width(800).url() : '');
	return {
		id: i + 1,
		type: item.shopCategory || 'original',
		title: item.title || '',
		series: item.series || '',
		medium: item.medium || '',
		size: item.dimensions || '',
		year: item.year ? String(item.year) : '',
		sold: !!item.sold,
		price: item.shopPrice || 'Price on Request',
		img,
	};
});
const SHOP_ITEMS_JSON = JSON.stringify(shopItemsData);
---
<Layout title="Shop" description="Own original paintings, fine art prints, and resin art by Justin Keishing — collected around the world.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Store",
      "name": "Arts by Justin — Shop",
      "description": "Own original paintings, fine art prints, and resin art by Justin Keishing.",
      "url": "https://artsbyjustin.com/shop",
      "brand": { "@type": "Brand", "name": "Arts by Justin" }
    })}></script>
  </Fragment>

  <!-- HERO -->
  <section class="shop-hero">
    <div class="hero-tag"><div class="hero-line"></div><span>The Shop</span><div class="hero-line"></div></div>
    <h1>Own a Piece of<br/><em>the Story.</em></h1>
    <p>Original paintings, fine art prints, and resin pieces — each one carrying the energy, purpose, and boldness that defines Arts by Justin. Find yours today.</p>
  </section>

  <!-- FILTER -->
  <div class="filter-bar">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="original">Originals</button>
    <button class="filter-btn" data-filter="print">Prints</button>
    <button class="filter-btn" data-filter="resin">Resin Art</button>
  </div>

  <!-- SHOP GRID -->
  <section class="shop-section">
    <div class="shop-grid" id="shopGrid"></div>
  </section>

  <!-- PRINTS SECTION -->
  <section class="prints-section" id="printsSection">
    <div class="section-header">
      <p class="label">Fine Art Prints</p>
      <div class="bar"></div>
      <h2>Take the Art Home —<br/><em>Any Painting. Two Sizes.</em></h2>
      <p>Can't get enough of a piece? Every artwork in Justin's collection is available as a high-quality fine art print. Choose your size, order instantly, and it ships straight to your door.</p>
    </div>
    <div class="prints-grid">
      <div class="print-card">
        <div class="print-img" style={`background:url('${printImage1}') center top/cover no-repeat;`}></div>
        <div class="print-info">
          <div>
            <div class="print-size">11 × 17"</div>
            <div class="print-dims">Standard Fine Art Print</div>
            <div class="print-features">
              <div class="print-feature">Premium archival paper</div>
              <div class="print-feature">Vibrant, fade-resistant inks</div>
              <div class="print-feature">Ships in protective tube</div>
              <div class="print-feature">Ready to frame</div>
            </div>
          </div>
          <div>
            <div class="print-price-row">
              <div class="print-price">Contact for pricing</div>
              <div class="print-note">Free shipping<br/>within the US</div>
            </div>
            <a class="btn-gold" href={etsyShopUrl} target="_blank" rel="noopener">View on Etsy →</a>
          </div>
        </div>
      </div>
      <div class="print-card">
        <div class="print-img" style={`background:url('${printImage2}') center top/cover no-repeat;`}></div>
        <div class="print-info">
          <div>
            <div class="print-size">12 × 18"</div>
            <div class="print-dims">Large Fine Art Print</div>
            <div class="print-features">
              <div class="print-feature">Premium archival paper</div>
              <div class="print-feature">Vibrant, fade-resistant inks</div>
              <div class="print-feature">Ships in protective tube</div>
              <div class="print-feature">Ready to frame</div>
            </div>
          </div>
          <div>
            <div class="print-price-row">
              <div class="print-price">Contact for pricing</div>
              <div class="print-note">Free shipping<br/>within the US</div>
            </div>
            <a class="btn-gold" href={etsyShopUrl} target="_blank" rel="noopener">View on Etsy →</a>
          </div>
        </div>
      </div>
    </div>
    <div class="custom-size-band">
      <div>
        <h3>Need a Different Size?</h3>
        <p>Want something bigger for a feature wall, or smaller for a tight space? Justin can accommodate custom print sizes on request — just reach out via the shop.</p>
      </div>
      <a class="btn-ghost" href={etsyShopUrl} target="_blank" rel="noopener">Visit the Etsy Shop →</a>
    </div>
  </section>

  <!-- INQUIRY MODAL -->
  <div class="inquiry-modal" id="inquiryModal">
    <div class="inq-box" id="inqBox">
      <button class="inq-close" id="inqCloseBtn">✕</button>
      <div id="inqForm">
        <div class="inq-title" id="inqTitle">Get in Touch</div>
        <div class="inq-sub">Justin will respond within 2–3 business days</div>
        <div class="inq-for" id="inqFor" style="display:none;"></div>
        <div class="form-grid">
          <div class="form-row"><label>First Name</label><input type="text" id="inqFirst" placeholder="Jordan"/></div>
          <div class="form-row"><label>Last Name</label><input type="text" id="inqLast" placeholder="Smith"/></div>
        </div>
        <div class="form-row"><label>Email</label><input type="email" id="inqEmail" placeholder="you@example.com"/></div>
        <div class="form-row">
          <label>I'm interested in…</label>
          <select id="inqType">
            <option value="purchase">Purchasing an original</option>
            <option value="print">Custom print size</option>
            <option value="general">General inquiry</option>
          </select>
        </div>
        <div class="form-row"><label>Message</label><textarea id="inqMsg" placeholder="Tell Justin what you're looking for…"></textarea></div>
        <button class="btn-gold btn-wide" id="inqSubmitBtn">Send Message →</button>
      </div>
      <div class="form-success" id="inqSuccess">
        <div class="check">✓</div>
        <h3>Message Sent</h3>
        <p>Thank you! Justin will be in touch within 2–3 business days.</p>
      </div>
    </div>
  </div>

</Layout>

<script define:vars={{ etsyShopUrl, SHOP_ITEMS_JSON }}>
const ETSY = etsyShopUrl;

const shopItems = JSON.parse(SHOP_ITEMS_JSON);

function getBadge(item) {
  if (item.type === 'print') return '<span class="shop-badge badge-print">Fine Art Print</span>';
  if (item.type === 'resin') return '<span class="shop-badge badge-resin">Resin Art</span>';
  if (item.sold) return '<span class="shop-badge badge-sold">Sold</span>';
  return '<span class="shop-badge badge-available">Available</span>';
}

function getActions(item) {
  if (item.type === 'print') return `<a class="btn-gold" href="${ETSY}" target="_blank" rel="noopener">Shop Prints on Etsy →</a>`;
  if (item.sold) return `<button class="btn-ghost" onclick="openInquiry(${item.id},'general')">Inquire About Similar Work →</button>`;
  if (item.type === 'resin') return `<a class="btn-gold" href="${ETSY}" target="_blank" rel="noopener">Request Pricing on Etsy →</a>`;
  return `<a class="btn-gold" href="${ETSY}" target="_blank" rel="noopener">Buy on Etsy — ${item.price} →</a>
          <button class="btn-ghost" onclick="openInquiry(${item.id},'print')">Inquire About a Print</button>`;
}

function buildShop(filter) {
  const grid = document.getElementById('shopGrid');
  grid.innerHTML = '';
  const items = filter === 'all' ? shopItems : shopItems.filter(i => i.type === filter);
  items.forEach(item => {
    const card = document.createElement('div');
    card.className = 'shop-card';
    card.innerHTML = `
      <div class="shop-img">
        <div class="shop-img-bg" style="background:url('${item.img}') center top/cover no-repeat;"></div>
        ${getBadge(item)}
      </div>
      <div class="shop-info">
        <div class="shop-cat">${item.series}</div>
        <div class="shop-title">${item.title}</div>
        <div class="shop-meta">${item.medium} · ${item.size} · ${item.year}</div>
        <div class="shop-price ${item.sold ? 'sold' : ''}">${item.sold ? 'Sold' : item.price}</div>
      </div>
      <div class="shop-actions">${getActions(item)}</div>`;
    grid.appendChild(card);
  });
  document.getElementById('printsSection').style.display = (filter === 'original') ? 'none' : '';
}

// Filter buttons
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    buildShop(btn.dataset.filter);
  });
});

// Inquiry modal
let currentInquiryId = null;
function openInquiry(id, type) {
  currentInquiryId = id;
  document.getElementById('inqForm').style.display = '';
  document.getElementById('inqSuccess').style.display = 'none';
  const sel = document.getElementById('inqType');
  const titleEl = document.getElementById('inqTitle');
  if (type === 'print') { sel.value = 'print'; titleEl.textContent = 'Inquire About a Print'; }
  else { sel.value = 'general'; titleEl.textContent = 'Get in Touch'; }
  const f = document.getElementById('inqFor');
  if (id) {
    const item = shopItems.find(x => x.id === id);
    f.style.display = '';
    f.innerHTML = `Regarding: <strong>${item.title}</strong> · ${item.medium}`;
  } else f.style.display = 'none';
  document.getElementById('inquiryModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeInquiry() {
  document.getElementById('inquiryModal').classList.remove('open');
  document.body.style.overflow = '';
}
document.getElementById('inquiryModal').addEventListener('click', e => { if (e.target === e.currentTarget) closeInquiry(); });
document.getElementById('inqCloseBtn').addEventListener('click', closeInquiry);
document.getElementById('inqSubmitBtn').addEventListener('click', () => {
  if (!document.getElementById('inqFirst').value.trim() || !document.getElementById('inqEmail').value.trim()) {
    alert('Please fill in your name and email.'); return;
  }
  document.getElementById('inqForm').style.display = 'none';
  document.getElementById('inqSuccess').style.display = 'block';
  setTimeout(closeInquiry, 3500);
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeInquiry(); });

buildShop('all');
</script>

<style>
  /* HERO */
  .shop-hero { padding:9rem 3rem 5rem; text-align:center; background:linear-gradient(135deg,#080808,#0f0800,#080808); position:relative; overflow:hidden; }
  .shop-hero::before { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 50% 0%,rgba(201,168,76,0.07),transparent 65%); }
  .hero-tag { display:inline-flex; align-items:center; gap:0.8rem; margin-bottom:1.5rem; }
  .hero-line { width:30px; height:1px; background:var(--gold); }
  .hero-tag span { font-size:0.68rem; letter-spacing:4px; text-transform:uppercase; color:var(--gold); }
  .shop-hero h1 { font-family:'Playfair Display',serif; font-size:clamp(2.8rem,5vw,4.5rem); line-height:1.1; margin-bottom:1rem; }
  .shop-hero h1 em { color:var(--gold); font-style:italic; }
  .shop-hero p { color:var(--gray2); max-width:560px; margin:0 auto; font-size:0.95rem; line-height:1.9; font-weight:300; }

  /* FILTER */
  .filter-bar { display:flex; justify-content:center; gap:0.5rem; flex-wrap:wrap; padding:3rem 3rem 2rem; }
  .filter-btn { background:transparent; color:var(--gray2); border:1px solid rgba(255,255,255,0.08); padding:0.6rem 1.4rem; font-size:0.72rem; letter-spacing:2px; text-transform:uppercase; cursor:pointer; transition:all 0.3s; font-family:'Inter',sans-serif; }
  .filter-btn:hover, .filter-btn.active { background:var(--gold); color:var(--black); border-color:var(--gold); font-weight:600; }

  /* SHOP GRID */
  .shop-section { padding:2rem 3rem 6rem; }
  .shop-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:3px; }
  .shop-card { background:var(--card); position:relative; display:flex; flex-direction:column; cursor:pointer; transition:transform 0.3s; }
  .shop-card:hover { transform:translateY(-4px); }
  .shop-img { aspect-ratio:3/4; overflow:hidden; position:relative; }
  .shop-img-bg { width:100%; height:100%; background-size:cover; background-position:center top; transition:transform 0.6s,filter 0.4s; filter:brightness(0.85); }
  .shop-card:hover .shop-img-bg { transform:scale(1.05); filter:brightness(1); }
  .shop-badge { position:absolute; top:0.8rem; left:0.8rem; font-size:0.55rem; letter-spacing:1.5px; text-transform:uppercase; padding:0.3rem 0.7rem; font-weight:600; }
  .badge-available { background:rgba(201,168,76,0.9); color:var(--black); }
  .badge-sold { background:rgba(180,30,30,0.9); color:#fff; }
  .badge-print { background:rgba(255,255,255,0.15); color:var(--white); border:1px solid rgba(255,255,255,0.2); backdrop-filter:blur(4px); }
  .badge-resin { background:rgba(0,180,180,0.8); color:#fff; }
  .shop-info { padding:1.2rem; flex:1; display:flex; flex-direction:column; gap:0.5rem; border-top:1px solid rgba(255,255,255,0.05); }
  .shop-cat { font-size:0.58rem; letter-spacing:2px; text-transform:uppercase; color:var(--gold); }
  .shop-title { font-family:'Playfair Display',serif; font-size:1rem; line-height:1.3; }
  .shop-meta { font-size:0.68rem; color:var(--gray2); letter-spacing:0.5px; }
  .shop-price { font-family:'Playfair Display',serif; font-size:1.3rem; color:var(--gold); margin-top:auto; padding-top:0.5rem; }
  .shop-price.sold { color:var(--gray); font-size:1rem; font-family:'Inter',sans-serif; letter-spacing:1px; text-transform:uppercase; }
  .shop-actions { padding:0 1.2rem 1.2rem; display:flex; flex-direction:column; gap:0.5rem; }

  /* PRINTS SECTION */
  .prints-section { padding:6rem 3rem; background:var(--dark); }
  .section-header { margin-bottom:3rem; }
  .section-header h2 { font-family:'Playfair Display',serif; font-size:2rem; margin-bottom:0.5rem; }
  .section-header h2 em { color:var(--gold); font-style:italic; }
  .section-header p { color:var(--gray2); font-size:0.9rem; line-height:1.8; max-width:560px; }
  .prints-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:3px; }
  .print-card { background:var(--card); display:flex; overflow:hidden; min-height:280px; }
  .print-img { width:220px; flex-shrink:0; background-size:cover; background-position:center top; }
  .print-info { padding:2.5rem; display:flex; flex-direction:column; justify-content:space-between; flex:1; }
  .print-size { font-family:'Playfair Display',serif; font-size:1.8rem; color:var(--white); margin-bottom:0.3rem; }
  .print-dims { font-size:0.7rem; letter-spacing:2px; text-transform:uppercase; color:var(--gray2); margin-bottom:1rem; }
  .print-features { display:flex; flex-direction:column; gap:0.4rem; margin-bottom:1.5rem; }
  .print-feature { display:flex; align-items:center; gap:0.6rem; font-size:0.78rem; color:var(--gray2); }
  .print-feature::before { content:'◆'; color:var(--gold); font-size:0.5rem; }
  .print-price-row { display:flex; align-items:center; gap:1rem; margin-bottom:1.2rem; }
  .print-price { font-family:'Playfair Display',serif; font-size:2rem; color:var(--gold); }
  .print-note { font-size:0.68rem; color:var(--gray); letter-spacing:1px; text-transform:uppercase; line-height:1.5; }
  .custom-size-band { background:rgba(201,168,76,0.04); border:1px solid rgba(201,168,76,0.15); padding:2.5rem 3rem; margin-top:3px; display:flex; justify-content:space-between; align-items:center; gap:2rem; flex-wrap:wrap; }
  .custom-size-band h3 { font-family:'Playfair Display',serif; font-size:1.4rem; margin-bottom:0.4rem; }
  .custom-size-band p { color:var(--gray2); font-size:0.85rem; max-width:500px; }

  /* SHARED BUTTON OVERRIDES FOR SHOP */
  .btn-gold { background:var(--gold); color:var(--black); padding:0.7rem 1.5rem; font-size:0.72rem; letter-spacing:2px; text-transform:uppercase; font-weight:700; border:none; cursor:pointer; transition:all 0.3s; text-align:center; text-decoration:none; display:block; }
  .btn-gold:hover { background:var(--gold-light); }
  .btn-ghost { background:transparent; color:var(--white); padding:0.7rem 1.5rem; font-size:0.72rem; letter-spacing:2px; text-transform:uppercase; border:1px solid rgba(255,255,255,0.15); cursor:pointer; transition:all 0.3s; text-align:center; text-decoration:none; display:block; }
  .btn-ghost:hover { border-color:var(--gold); color:var(--gold); }
  .btn-wide { width:100%; padding:1rem; }

  /* INQUIRY MODAL */
  .inquiry-modal { position:fixed; inset:0; z-index:2000; background:rgba(0,0,0,0); pointer-events:none; transition:background 0.3s; display:flex; align-items:center; justify-content:center; }
  .inquiry-modal.open { background:rgba(0,0,0,0.9); pointer-events:all; }
  .inq-box { background:#111; border:1px solid rgba(201,168,76,0.2); max-width:520px; width:92%; padding:3rem; opacity:0; transform:translateY(20px); transition:all 0.4s; position:relative; max-height:90vh; overflow-y:auto; }
  .inquiry-modal.open .inq-box { opacity:1; transform:translateY(0); }
  .inq-title { font-family:'Playfair Display',serif; font-size:1.6rem; margin-bottom:0.4rem; }
  .inq-sub { font-size:0.8rem; color:var(--gray2); letter-spacing:1px; margin-bottom:2rem; }
  .inq-for { background:rgba(201,168,76,0.06); border-left:2px solid var(--gold); padding:0.8rem 1rem; margin-bottom:2rem; font-size:0.85rem; color:var(--gray2); }
  .inq-for strong { color:var(--white); }
  .form-row { margin-bottom:1.2rem; }
  .form-row label { display:block; font-size:0.68rem; letter-spacing:2px; text-transform:uppercase; color:var(--gray2); margin-bottom:0.5rem; }
  .form-row input, .form-row textarea, .form-row select { width:100%; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); color:var(--white); padding:0.75rem 1rem; font-family:'Inter',sans-serif; font-size:0.88rem; outline:none; transition:border-color 0.3s; }
  .form-row input:focus, .form-row textarea:focus, .form-row select:focus { border-color:var(--gold); }
  .form-row textarea { min-height:100px; resize:vertical; }
  .form-row select option { background:#111; }
  .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .inq-close { position:absolute; top:1rem; right:1rem; width:36px; height:36px; background:transparent; border:1px solid rgba(255,255,255,0.1); color:var(--gray2); cursor:pointer; font-size:1rem; display:flex; align-items:center; justify-content:center; transition:all 0.3s; }
  .inq-close:hover { border-color:var(--gold); color:var(--gold); }
  .form-success { text-align:center; padding:2rem 0; display:none; }
  .form-success .check { font-size:3rem; margin-bottom:1rem; color:var(--gold); }
  .form-success h3 { font-family:'Playfair Display',serif; font-size:1.5rem; margin-bottom:0.5rem; }
  .form-success p { color:var(--gray2); font-size:0.88rem; line-height:1.7; }

  /* RESPONSIVE */
  @media (max-width:900px) {
    .shop-section, .filter-bar { padding-inline:1.5rem; }
    .shop-grid { grid-template-columns:repeat(2,1fr); }
    .prints-section { padding:4rem 1.5rem; }
    .prints-grid { grid-template-columns:1fr; }
    .print-card { flex-direction:column; }
    .print-img { width:100%; height:220px; }
    .custom-size-band { flex-direction:column; text-align:center; padding:2rem 1.5rem; }
  }
  @media (max-width:480px) {
    .form-grid { grid-template-columns:1fr; }
    .shop-hero { padding-inline:1.5rem; }
  }
</style>
