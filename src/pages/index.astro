---
import { SEED_ARTWORKS } from '../data/artworks';
import Layout from '../layouts/Layout.astro';
import { getArtworks, getSiteSettings, urlFor } from '../lib/sanity';

let rawArtworks: any[] = [];
try {
	rawArtworks = await getArtworks();
} catch (e) {}
if (!rawArtworks || rawArtworks.length === 0) rawArtworks = SEED_ARTWORKS as any[];

// Normalize to a consistent shape
const artworks = rawArtworks.map((a: any) => ({
	_id: a._id,
	title: a.title || '',
	medium: a.medium || '',
	year: a.year ? String(a.year) : '',
	category: a.category || '',
	featured: !!a.featured,
	heroFeature: a.heroFeature !== false,
	colorGradient: a.colorGradient || a.fallback || '',
	imageUrl:
		a.imageUrl || (a.image ? urlFor(a.image).width(1200).format('webp').quality(68).url() : ''),
	imageUrlTablet:
		a.imageUrlTablet ||
		(a.image ? urlFor(a.image).width(960).format('webp').quality(68).url() : ''),
	imageUrlMobile:
		a.imageUrlMobile ||
		(a.image ? urlFor(a.image).width(640).format('webp').quality(70).url() : ''),
	imageUrlThumb:
		a.imageUrlThumb || (a.image ? urlFor(a.image).width(480).format('webp').quality(65).url() : ''),
}));

const heroArtworks = artworks.filter((a) => a.heroFeature && a.imageUrl).slice(0, 8);
const firstHero = heroArtworks[0];
// Hero LCP — served from R2 (same origin as fonts, stable URL, 103 Early Hints compatible)
const heroDesktopUrl = 'https://assets.spiritmediapublishing.com/artsbyjustin/hero-desktop.webp';
const heroTabletUrl = 'https://assets.spiritmediapublishing.com/artsbyjustin/hero-tablet.webp';
// hero-mobile-v2.webp is a 480w q=70 re-encode of hero-mobile.webp (128KB → 63KB).
const heroMobileUrl = 'https://assets.spiritmediapublishing.com/artsbyjustin/hero-mobile-v2.webp';
const featuredArtworks = (() => {
	const f = artworks.filter((a) => a.featured);
	return f.length >= 3 ? f.slice(0, 5) : artworks.slice(0, 5);
})();
const stripArtworks = artworks.slice(0, 5);

// Fetch siteSettings first
let siteSettings: any = {};
try {
	siteSettings = await getSiteSettings();
} catch (e) {
	console.error('Error fetching siteSettings:', e);
}

// Use Sanity categories or fall back to defaults
const defaultCategories = [
	{ name: 'Sports & Motion', gradient: 'linear-gradient(135deg,#000,#001133,#003399,#cc2200)' },
	{ name: 'Portraits & Figurative', gradient: 'linear-gradient(135deg,#111,#1a1400,#c9a84c,#444)' },
	{
		name: 'Faith & Inspiration',
		gradient: 'linear-gradient(135deg,#0a0010,#1a0030,#ff2200,#ffaa00,#7700cc)',
	},
	{
		name: 'Abstract & Expressive',
		gradient: 'linear-gradient(135deg,#000,#001122,#ff6600,#00aacc)',
	},
	{ name: 'Nature & Ocean', gradient: 'linear-gradient(135deg,#001a0a,#003322,#00aacc,#006644)' },
	{
		name: 'Animals & Wildlife',
		gradient: 'linear-gradient(135deg,#0a0800,#1a1000,#cc8800,#442200)',
	},
];
const CATEGORY_DEFS =
	siteSettings?.artCategories?.length > 0 ? siteSettings.artCategories : defaultCategories;
const categories = CATEGORY_DEFS.map((cat) => ({
	...cat,
	count: artworks.filter((a) => a.category === cat.name).length,
	artwork: artworks.find((a) => a.category === cat.name) || null,
}));

// Pass artworks as JSON for client-side hero rotation
const artworksJson = JSON.stringify(heroArtworks);

// Extract values from siteSettings with sensible defaults
const location = siteSettings?.location || 'Raleigh, NC';
const foundingYear = siteSettings?.foundingYear || 2020;
const artistName = siteSettings?.artistName || 'Justin';
const tagline = siteSettings?.tagline || 'Art With a Purpose';
const bio = siteSettings?.bio || '';

// About section image from Sanity (with portrait artwork fallback)
const aboutImageUrl = siteSettings?.aboutPortraitImage
	? urlFor(siteSettings.aboutPortraitImage).width(800).url()
	: (() => {
			const portrait = rawArtworks.find((a: any) => a.imageType === 'portrait' && a.image);
			return portrait ? urlFor(portrait.image).width(800).format('webp').url() : null;
		})();

// Testimonials with Sanity fallback
const defaultTestimonials = [
	{
		quote:
			"Justin's work stopped me in my tracks. I walked past it twice before I realized I couldn't leave without it. A year later I still discover something new every day.",
		attribution: 'Collector, New York',
		rating: '★★★★★',
	},
	{
		quote:
			'I commissioned a piece for my office and Justin captured exactly what I described — but more powerfully than I ever imagined. People ask about it every single day.',
		attribution: 'Commission Client, Dallas',
		rating: '★★★★★',
	},
	{
		quote:
			"There's a spirituality in his work that you feel before you understand. I knew I had to own this piece the moment I saw it.",
		attribution: 'Collector, London',
		rating: '★★★★★',
	},
];
const testimonials =
	siteSettings?.testimonials?.length > 0 ? siteSettings.testimonials : defaultTestimonials;

// Shop links with Sanity fallback
const defaultShopLinks = [
	{ name: 'Etsy', description: 'Original works & prints', url: 'https://artsbyjustin.etsy.com' },
	{
		name: 'Pixels',
		description: 'Museum-quality prints',
		url: 'https://fineartamerica.com/profiles/justin-keishing/shop',
	},
	{
		name: 'Fine Art America',
		description: 'Shipped worldwide',
		url: 'https://fineartamerica.com/profiles/justin-keishing/shop',
	},
	{
		name: 'ARTMO',
		description: 'Global art community',
		url: 'https://artmo.com/user/Artsbyjustin',
	},
];
const shopLinks = siteSettings?.shopLinks?.length > 0 ? siteSettings.shopLinks : defaultShopLinks;

// Home page stats with Sanity fallback
const defaultHomeStats = { worksCreated: '450+', artShows: '26+', countriesExhibited: '8+' };
const homeStats = siteSettings?.homePageStats
	? { ...defaultHomeStats, ...siteSettings.homePageStats }
	: defaultHomeStats;
---
<Layout title={tagline} description={bio || `Bold, expressive, spirit-led art created in ${location} — collected around the world. Original acrylic & mixed media works by ${artistName}.`}>
  <Fragment slot="head">
    {/* Hero painting is hidden on mobile (<1024px) — see §6 text-first LCP
        pattern in performance-gate.md. Preload gated to desktop so PSI mobile
        never fetches the hero image. */}
    <link
      rel="preload"
      as="image"
      href={heroDesktopUrl}
      imagesrcset={`${heroTabletUrl} 960w, ${heroDesktopUrl} 1200w`}
      imagesizes="835px"
      media="(min-width: 1024px)"
      fetchpriority="high"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Arts by Justin",
      "url": "https://artsbyjustin.com",
      "description": bio || `Bold, expressive, spirit-led art created in ${location} — collected around the world. Original acrylic & mixed media works by ${artistName}.`,
      "founder": { "@type": "Person", "name": "Justin Keishing" },
      "foundingDate": String(foundingYear),
      "areaServed": "Worldwide",
      "serviceType": ["Original Artwork", "Commissioned Art", "Mixed Media Art", "Acrylic Paintings"]
    })}></script>
  </Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-painting" id="heroPainting">
      <img
        class="hero-bg hero-img"
        id="heroImg"
        src={heroDesktopUrl}
        srcset={`${heroTabletUrl} 960w, ${heroDesktopUrl} 1200w`}
        sizes="835px"
        width="1200"
        height="858"
        alt={firstHero?.title || 'Featured artwork by Justin Keishing'}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="hero-fade"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">
        <div class="hero-line"></div>
        <span>{location} · Est. {foundingYear}</span>
      </div>
      <h1>{tagline}</h1>
      <p class="hero-sub">Bold. Expressive. Spirit-led. Original acrylic &amp; mixed media works — created in {location}, collected around the world.</p>
      <div class="hero-btns">
        <a href="/contact" class="btn-gold">Explore the Work →</a>
        <a href="/about" class="btn-ghost">My Story</a>
      </div>
    </div>
    <div class="hero-caption" id="heroCaption">{heroArtworks[0] ? `${heroArtworks[0].title} · ${heroArtworks[0].medium}` : ''}</div>
    <div class="scroll-hint">
      <div class="scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- GALLERY STRIP -->
  <div class="strip">
    {stripArtworks.map((a) => (
      <div class="strip-item">
        <div class="strip-bg" style={a.imageUrlThumb ? `background:url('${a.imageUrlThumb}') center/cover no-repeat` : (a.imageUrl ? `background:url('${a.imageUrl}') center/cover no-repeat` : `background:${a.colorGradient || '#222'}`)}></div>
        <div class="strip-caption"><span>{a.title} · {a.medium}</span></div>
      </div>
    ))}
  </div>

  <!-- ABOUT -->
  <section class="about">
    <div class="about-img">
      <div class="about-img-bg" style={
        aboutImageUrl
          ? `background:url('${aboutImageUrl}') center/cover no-repeat`
          : 'background:linear-gradient(135deg,#111,#1a1400,#c9a84c,#444)'
      }></div>
      <div class="about-img-overlay"></div>
      <div class="about-badge">Artist · {location}</div>
    </div>
    <div class="about-body">
      <p class="label">The Story</p>
      <div class="bar"></div>
      <h2>From Poverty<br/>to Fine Art</h2>
      <p>My journey didn't start in a studio. It started with a dream bigger than my circumstances — a belief that beauty could exist even in the hardest places.</p>
      <p>Every canvas I touch carries that story. Of faith. Of resilience. Of the conviction that art can change how we see the world and ourselves.</p>
      <div class="pull-quote">
        <p>"I don't just create art. I create conversations, connections, and change."</p>
      </div>
      <br/>
      <a href="/about" class="btn-gold">Read My Full Story →</a>
    </div>
  </section>

  <!-- FEATURED WORKS -->
  <section class="works">
    <div class="works-hdr">
      <div>
        <p class="label">Portfolio</p>
        <div class="bar"></div>
        <h2>Featured Works</h2>
      </div>
      <a href="/gallery" class="btn-ghost">View All Work →</a>
    </div>
    <div class="masonry">
      {featuredArtworks.map((a, i) => (
        <div class={`art${i === 0 ? ' span-row' : ''}`}>
          <div class="art-bg" style={a.imageUrlThumb ? `background:url('${a.imageUrlThumb}') center/cover no-repeat` : (a.imageUrl ? `background:url('${a.imageUrl}') center/cover no-repeat` : `background:${a.colorGradient || '#222'}`)}></div>
          <div class="art-tag">{a.category}</div>
          <div class="art-info">
            <h3>{a.title}</h3>
            <p>{a.medium} · {a.year}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="cats">
    <div class="cats-intro">
      <p class="label" style="text-align:center;">Browse by Theme</p>
      <div class="bar" style="margin:0.5rem auto 1rem;"></div>
      <h2>Every Canvas Tells a Story</h2>
      <p>From sports legends to spiritual journeys — explore Justin's world.</p>
    </div>
    <div class="cat-grid">
      {categories.map((cat) => (
        <div class="cat">
          <div class="cat-bg" style={
            cat.artwork?.imageUrlThumb
              ? `background:url('${cat.artwork.imageUrlThumb}') center/cover no-repeat`
              : (cat.artwork?.imageUrl
                ? `background:url('${cat.artwork.imageUrl}') center/cover no-repeat`
                : `background:${cat.artwork?.colorGradient || cat.gradient}`)
          }></div>
          <div class="cat-info">
            <h3>{cat.name}</h3>
            <span>{cat.count > 0 ? `${cat.count} Works` : 'Explore'}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- PRESS & RECOGNITION -->
  <section class="mag">
    <div>
      <p class="label">Press &amp; Recognition</p>
      <div class="bar"></div>
      <h2>Recognized<br/>Beyond the Studio</h2>
      <p>Justin's work has earned its place not just on walls — but in publications, galleries, and art shows that celebrate artists who create with purpose and vision.</p>
      <p>From Raleigh to international stages, the story keeps growing.</p>
      <a href="/press" class="btn-gold">View Press &amp; Awards →</a>
    </div>
    <div class="mag-card">
      <span class="mag-badge">Featured Magazine</span>
      <div class="mag-title">From Poverty<br/>to Fine Art</div>
      <div class="mag-date">August 2023</div>
      <p class="mag-body">A full feature on Justin Keishing's remarkable journey from humble beginnings to international recognition — a story of faith, resilience, and art made with purpose.</p>
      <a href="/press" class="mag-link">Read the Full Feature →</a>
    </div>
  </section>

  <!-- COMMISSIONS -->
  <section class="comm">
    <p class="label" style="text-align:center;">Work With Justin</p>
    <div class="bar" style="margin:0.5rem auto 1.5rem;"></div>
    <h2>Let's Create Something<br/>Just for You</h2>
    <p class="comm-sub">Have a vision? A story you want told in paint? I take on a limited number of commissioned works each year. Every piece is personal, intentional, and made with purpose.</p>
    <div class="steps">
      <div class="step"><div class="step-n" aria-hidden="true">01</div><h3>Connect</h3><p>Reach out and share your idea, vision, or the story you want told.</p></div>
      <div class="step"><div class="step-n" aria-hidden="true">02</div><h3>Consult</h3><p>We discuss concept, size, medium, timeline, and investment.</p></div>
      <div class="step"><div class="step-n" aria-hidden="true">03</div><h3>Create</h3><p>Justin brings your vision to life with care, intention, and purpose.</p></div>
      <div class="step"><div class="step-n" aria-hidden="true">04</div><h3>Deliver</h3><p>Your one-of-a-kind piece arrives, ready to hang and move people.</p></div>
    </div>
    <a href="/commissions" class="btn-gold">Start a Commission →</a>
  </section>

  <!-- STATS BAND -->
  <section class="stats-band">
    <div class="stats-text">
      <p class="label">Art Shows</p>
      <div class="bar"></div>
      <h2>Seen Around<br/>the World</h2>
      <p>Because of you — my collectors and supporters — my work has found walls in galleries and art shows internationally. Every show is a reminder of why I create.</p>
      <a href="/press" class="btn-ghost">See Where I've Shown →</a>
    </div>
    <div class="stats-nums">
      <div class="stat"><div class="stat-n">{homeStats.worksCreated}</div><div class="stat-l">Works Created</div></div>
      <div class="stat"><div class="stat-n">{homeStats.artShows}</div><div class="stat-l">Art Shows</div></div>
      <div class="stat"><div class="stat-n">{homeStats.countriesExhibited}</div><div class="stat-l">Countries</div></div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testi">
    <p class="label" style="text-align:center;">Collector Stories</p>
    <div class="bar" style="margin:0.5rem auto 1rem;"></div>
    <h2>What Collectors Say</h2>
    <div class="testi-grid">
      {testimonials.map((t: any) => (
        <div class="testi-card">
          <div class="stars">{t.rating || '★★★★★'}</div>
          <p class="testi-q">"{t.quote}"</p>
          <div class="testi-by">— {t.attribution}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- SHOP -->
  <section class="shop">
    <div class="shop-top">
      <div>
        <p class="label">Collect the Work</p>
        <div class="bar"></div>
        <h2>Take a Piece Home</h2>
        <p>Originals, museum-quality prints, and more — available across multiple platforms so collectors worldwide can find and own Justin's work.</p>
      </div>
    </div>
    <div class="shop-grid">
      {shopLinks.map((link: any) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="shop-card"><div><div class="shop-n">{link.name}</div><div class="shop-d">{link.description}</div></div><span class="shop-arr">→</span></a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <h2>Inspired?<br/>Let's <em>Connect.</em></h2>
    <p>Whether you're a collector, a gallery, or someone who just feels<br/>something looking at this work — I'd love to hear from you.</p>
    <a href="/contact" class="btn-gold">Contact Justin →</a>
  </section>

</Layout>

<script define:vars={{ artworksJson }}>
  const heroArtworks = JSON.parse(artworksJson);
  if (heroArtworks.length > 1) {
    let idx = 1;
    const wrap = document.getElementById('heroPainting');
    const caption = document.getElementById('heroCaption');
    setInterval(() => {
      const a = heroArtworks[idx % heroArtworks.length];
      if (wrap) {
        const bg = wrap.querySelector('.hero-bg');
        if (bg) {
          if (bg.tagName === 'IMG') {
            if (a.imageUrl) {
              if (a.imageUrlMobile) {
                const tablet = a.imageUrlTablet || a.imageUrl;
                bg.srcset = `${a.imageUrlMobile} 640w, ${tablet} 960w, ${a.imageUrl} 1200w`;
              }
              bg.src = a.imageUrlMobile || a.imageUrl;
              bg.alt = a.title || '';
            }
          } else {
            if (a.imageUrl) {
              bg.style.background = `url('${a.imageUrl}') center/cover no-repeat`;
            } else {
              bg.style.background = a.colorGradient || '#111';
            }
          }
        }
      }
      if (caption) caption.textContent = `${a.title} · ${a.medium}`;
      idx++;
    }, 5000);
  }
</script>

<style>
  /* HERO */
  .hero { height:100vh; position:relative; display:flex; align-items:center; overflow:hidden; }
  .hero-painting { position:absolute; right:0; top:0; bottom:0; width:58%; overflow:hidden; }
  .hero-bg { position:absolute; inset:0; filter:brightness(0.75); transition:background 0.8s, opacity 0.8s; }
  .hero-img { width:100%; height:100%; object-fit:cover; object-position:center; }
  .hero-fade { position:absolute; inset:0; background:linear-gradient(to right,#080808 30%,rgba(8,8,8,0.5) 60%,rgba(8,8,8,0.1) 100%); }
  .hero-content { position:relative; z-index:2; padding:0 3rem; max-width:600px; }
  .hero-eyebrow { display:inline-flex; align-items:center; gap:0.8rem; margin-bottom:2rem; }
  .hero-line { width:30px; height:1px; background:var(--gold); }
  .hero-eyebrow span { font-size:0.68rem; letter-spacing:4px; text-transform:uppercase; color:var(--gold); }
  .hero h1 { font-family:'Playfair Display',serif; font-size:clamp(3.2rem,5.5vw,5.5rem); line-height:1.05; margin-bottom:1.5rem; font-weight:700; }
  .hero h1 em { color:var(--gold); font-style:italic; display:block; }
  .hero-sub { color:var(--gray2); font-size:0.97rem; line-height:1.9; margin-bottom:2.5rem; font-weight:300; max-width:420px; }
  .hero-btns { display:flex; gap:1rem; flex-wrap:wrap; }
  .hero-caption { position:absolute; bottom:1.8rem; right:2rem; font-size:0.65rem; letter-spacing:3px; color:rgba(255,255,255,0.3); text-transform:uppercase; z-index:2; }
  .scroll-hint { position:absolute; bottom:2.5rem; left:3rem; display:flex; align-items:center; gap:1rem; color:#9a9a9a; font-size:0.68rem; letter-spacing:3px; text-transform:uppercase; }
  .scroll-line { width:40px; height:1px; background:var(--gold); animation:grow 2s ease-in-out infinite; }
  @keyframes grow { 0%,100%{width:40px;opacity:0.4;} 50%{width:65px;opacity:1;} }

  /* STRIP */
  .strip { display:grid; grid-template-columns:repeat(5,1fr); height:260px; gap:2px; }
  .strip-item { overflow:hidden; position:relative; cursor:pointer; }
  .strip-bg { width:100%; height:100%; transition:transform 0.6s,filter 0.4s; filter:brightness(0.65) saturate(0.8); }
  .strip-item:hover .strip-bg { transform:scale(1.08); filter:brightness(0.9) saturate(1.2); }
  .strip-caption { position:absolute; bottom:0; left:0; right:0; padding:0.8rem; background:linear-gradient(to top,rgba(0,0,0,0.85),transparent); transform:translateY(100%); transition:transform 0.3s; }
  .strip-item:hover .strip-caption { transform:translateY(0); }
  .strip-caption span { font-size:0.65rem; letter-spacing:1.5px; text-transform:uppercase; color:rgba(255,255,255,0.85); }

  /* ABOUT */
  .about { display:grid; grid-template-columns:1fr 1fr; min-height:650px; }
  .about-img { position:relative; overflow:hidden; }
  .about-img-bg { position:absolute; inset:0; filter:brightness(0.8); }
  .about-img-overlay { position:absolute; inset:0; background:linear-gradient(to right,transparent 60%,#111 100%); }
  .about-badge { position:absolute; top:2rem; left:2rem; background:var(--gold); color:var(--black); font-size:0.62rem; letter-spacing:3px; text-transform:uppercase; padding:0.4rem 1rem; font-weight:700; }
  .about-body { padding:5rem 4rem; display:flex; flex-direction:column; justify-content:center; background:#111; }
  .about-body h2 { font-family:'Playfair Display',serif; font-size:2.4rem; line-height:1.2; margin-bottom:1.5rem; }
  .about-body p { color:var(--gray2); font-size:0.93rem; line-height:1.9; margin-bottom:1rem; font-weight:300; }

  /* WORKS / MASONRY */
  .works { padding:6rem 3rem; background:var(--black); }
  .works-hdr { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:2.5rem; }
  .works-hdr h2 { font-family:'Playfair Display',serif; font-size:2.2rem; }
  .masonry { display:grid; grid-template-columns:1.5fr 1fr 1fr; grid-template-rows:320px 280px; gap:3px; }
  .art { position:relative; overflow:hidden; cursor:pointer; }
  .art-bg { width:100%; height:100%; transition:transform 0.6s,filter 0.4s; filter:brightness(0.8); }
  .art:hover .art-bg { transform:scale(1.06); filter:brightness(1); }
  .art-info { position:absolute; bottom:0; left:0; right:0; padding:1.2rem 1.5rem; background:linear-gradient(to top,rgba(0,0,0,0.92),transparent); transform:translateY(100%); transition:transform 0.35s; }
  .art:hover .art-info { transform:translateY(0); }
  .art-info h3 { font-family:'Playfair Display',serif; font-size:0.95rem; margin-bottom:0.2rem; }
  .art-info p { font-size:0.7rem; letter-spacing:1px; text-transform:uppercase; color:var(--gray2); }
  .art-tag { position:absolute; top:1rem; left:1rem; background:rgba(8,8,8,0.7); font-size:0.6rem; letter-spacing:2px; text-transform:uppercase; padding:0.3rem 0.7rem; color:var(--gold); border:1px solid rgba(201,168,76,0.3); }
  .span-row { grid-row:span 2; }

  /* CATEGORIES */
  .cats { padding:5rem 3rem; background:#111; }
  .cats-intro { text-align:center; margin-bottom:3rem; }
  .cats-intro h2 { font-family:'Playfair Display',serif; font-size:2.2rem; margin-bottom:0.8rem; }
  .cats-intro p { color:var(--gray2); font-size:0.9rem; font-weight:300; }
  .cat-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:2px; }
  .cat { position:relative; aspect-ratio:2/3; overflow:hidden; cursor:pointer; }
